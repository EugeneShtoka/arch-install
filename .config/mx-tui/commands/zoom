#!/bin/sh
# /zoom [topic] — start a Zoom call, join it yourself, and propose the invite text.
#
# mx-tui knows nothing about Zoom: it runs this file and puts whatever the file
# prints on stdout into the composer, for you to send or not. Everything here is
# yours to change.
#
# What mx-tui gives this script:
#   "$1" / $MX_ARG   the words after the command, as one argument
#   $MX_ROOM         the room you are writing in, as it is labelled there
#   $MX_ROOM_ID      that room's ID
#   $MX_USER         your own MXID
#
# Two ways to work, and it takes whichever is configured in
# ~/.config/mx-tui/zoom.env:
#
#   1. ZOOM_LINK — your Personal Meeting link, pasted from https://zoom.us/profile.
#      No API, no app, no network call. Always the same room, which is exactly right
#      for "jump on a call" and wrong for two calls at once.
#   2. ZOOM_ACCOUNT_ID + ZOOM_CLIENT_ID + ZOOM_CLIENT_SECRET — a Server-to-Server
#      OAuth app, which creates a fresh meeting every time.
set -eu

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/mx-tui/zoom.env"
# shellcheck source=/dev/null
[ -r "$env_file" ] && . "$env_file"

topic=${1:-${MX_ROOM:-call}}

# open hands a URL to the desktop client if the scheme is Zoom's own, else to the
# browser. Detached, and with its output thrown away: a background child that keeps
# hold of stdout is a script that never appears to finish.
open_url() {
	[ -n "${ZOOM_DRY:-}" ] && { echo "would open: $1" >&2; return 0; }
	setsid xdg-open "$1" >/dev/null 2>&1 &
}

# ── 1. A personal meeting link: nothing to set up but the link itself ──────────
if [ -n "${ZOOM_LINK:-}" ]; then
	# The desktop client starts *your* meeting from its own URL scheme, which needs
	# the meeting number and passcode out of the link.
	confno=$(printf '%s' "$ZOOM_LINK" | sed -n 's|.*/j/\([0-9]\{1,\}\).*|\1|p')
	pwd_param=$(printf '%s' "$ZOOM_LINK" | sed -n 's|.*[?&]pwd=\([^&]*\).*|\1|p')
	if [ -n "$confno" ] && command -v zoom >/dev/null 2>&1; then
		start="zoommtg://zoom.us/start?confno=$confno"
		[ -n "$pwd_param" ] && start="$start&pwd=$pwd_param"
		open_url "$start"
	else
		# No client, or a link in a shape this cannot read: the browser handles both.
		open_url "$ZOOM_LINK"
	fi
	printf '%s — Zoom: %s\n' "$topic" "$ZOOM_LINK"
	exit 0
fi

# ── 2. A Server-to-Server OAuth app: a fresh meeting each time ─────────────────
missing=""
for var in ZOOM_ACCOUNT_ID ZOOM_CLIENT_ID ZOOM_CLIENT_SECRET; do
	eval "value=\${$var:-}"
	[ -z "$value" ] && missing="$missing $var"
done
if [ -n "$missing" ]; then
	# First time only: put the page with the link on it in front of you, since the
	# one thing that cannot be automated is the copy-paste. There is no "log in to
	# Zoom" to run here — every Zoom API route needs an app you register by hand in
	# their web console, so the shortest honest path is their profile page.
	#
	# A marker file, so a second /zoom does not open a second tab.
	marker="${XDG_STATE_HOME:-$HOME/.local/state}/mx-tui/zoom-setup-opened"
	if [ ! -e "$marker" ]; then
		mkdir -p "$(dirname "$marker")" && : >"$marker"
		open_url "https://zoom.us/profile"
		echo "opened zoom.us/profile — copy the invite link under your Personal Meeting ID into $env_file as ZOOM_LINK=\"…\"" >&2
		exit 1
	fi
	# The first line of stderr is what mx-tui shows on the status line, so it says
	# the one thing to do next — and names the cheap option first.
	echo "no Zoom set up yet: paste your personal meeting link as ZOOM_LINK in $env_file (or set$missing there)" >&2
	exit 1
fi

token=$(curl -sS -X POST -u "$ZOOM_CLIENT_ID:$ZOOM_CLIENT_SECRET" \
	"https://zoom.us/oauth/token?grant_type=account_credentials&account_id=$ZOOM_ACCOUNT_ID" |
	jq -r '.access_token // empty')
if [ -z "$token" ]; then
	echo "Zoom refused the credentials in $env_file" >&2
	exit 1
fi

meeting=$(curl -sS -X POST \
	-H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
	-d "$(jq -nc --arg t "$topic" '{topic:$t, type:1, settings:{join_before_host:true}}')" \
	https://api.zoom.us/v2/users/me/meetings)

join=$(printf '%s' "$meeting" | jq -r '.join_url // empty')
start=$(printf '%s' "$meeting" | jq -r '.start_url // empty')
if [ -z "$join" ]; then
	echo "Zoom did not make a meeting: $(printf '%s' "$meeting" | jq -r '.message // "no reason given"')" >&2
	exit 1
fi
[ -n "$start" ] && open_url "$start"
printf '%s — Zoom: %s\n' "$topic" "$join"
