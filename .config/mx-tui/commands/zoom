# /zoom [topic] — start a Zoom call, join it yourself, and propose the invite text.
#
# mx-tui knows nothing about Zoom: it runs this file and puts whatever the file
# prints on stdout into the composer, for you to send or not. Everything here is
# yours to change.
#
# What mx-tui gives this script:
#   "$1" / $MX_ARG   the words after the command, as one argument
#   $MX_ROOM         the room you are writing in, as it is labelled there
#   $MX_ROOM_ID      that room's ID
#   $MX_USER         your own MXID
#
# ==============================================================================
# TWO WAYS TO WORK. Both read ~/.config/mx-tui/zoom.env (chmod 600).
# ==============================================================================
#
# ── 1. ZOOM_LINK — your Personal Meeting Room. Nothing to register. ───────────
#
#   https://zoom.us/profile → "Personal Meeting ID" → copy the invite link under
#   it. It looks like
#
#     https://us04web.zoom.us/j/6530524978?pwd=tYFEL……ItD.1
#
#   and the ?pwd= part *is* the passcode, which is why the link alone is enough to
#   join. Paste it as ZOOM_LINK and /zoom works: no app, no API, no network call —
#   the desktop client is started through its own zoommtg:// scheme.
#
#   The catch is worth knowing before you paste that link into a group room: **it
#   is permanent**. Your personal room has one number and one passcode, so anybody
#   who keeps the link — anybody still in that room next year, and on a bridged
#   room, whoever runs the bridge — can walk into any future meeting you hold
#   there. For a 1:1 with someone you talk to daily that is fine. For a room with
#   twenty people in it, use the second way.
#
# ── 2. Server-to-Server OAuth — a fresh meeting, and a fresh passcode, each time ─
#
#   This is the "properly, with a secret" version. The meeting is created on demand,
#   so its number and passcode are disposable and the link stops working when the
#   meeting is over.
#
#   Getting the three values (verified against developers.zoom.us, Sep 2026):
#
#     a. Sign in at https://marketplace.zoom.us with the Zoom account you want the
#        meetings to belong to.
#     b. Bottom-left: **Developer** → **Created apps** (or the top-right
#        **Develop** → **Build an app**).
#     c. Choose **Server-to-Server OAuth app** → Create, and give it any name
#        ("mx-tui" will do). This app type has no login flow and no redirect URL —
#        it is meant for exactly this: a script acting as you.
#     d. **Scopes** tab → Add scopes → Meeting → tick the one that lets an app
#        create meetings. Depending on how old your account's marketplace is that
#        is either the granular `meeting:write:meeting:admin` or the classic
#        `meeting:write:admin`. Only that one is needed.
#     e. **Activation** tab → Activate. Zoom will not issue a token for an app
#        that has not been activated, and this is the step everybody forgets.
#     f. **App Credentials** tab → copy **Account ID**, **Client ID** and
#        **Client Secret** into zoom.env.
#
#   Notes on plans and roles: Zoom's documentation does not list a paid plan as a
#   requirement, but the scopes you are *offered* depend on your role — you need
#   permission to view and edit server-to-server apps, which on a personal account
#   you have by being its owner. If the meeting scope is not offered at step (d),
#   that is the account's plan or role talking, and ZOOM_LINK is the way round it.
#
#   Where the secret must not go: not in mx-tui's config.toml, not on a command
#   line (argv is world-readable in /proc), not in a chat room. zoom.env, mode
#   600, is the whole of it — this script is the only thing that reads it.
#
set -eu

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/mx-tui/zoom.env"
# shellcheck source=/dev/null
[ -r "$env_file" ] && . "$env_file"

topic=${1:-${MX_ROOM:-call}}

# open hands a URL to the desktop client if the scheme is Zoom's own, else to the
# browser. Detached, and with its output thrown away: a background child that keeps
# hold of stdout is a script that never appears to finish.
open_url() {
	[ -n "${ZOOM_DRY:-}" ] && { echo "would open: $1" >&2; return 0; }
	setsid xdg-open "$1" >/dev/null 2>&1 &
}

# ── 1. A personal meeting link: nothing to set up but the link itself ──────────
if [ -n "${ZOOM_LINK:-}" ]; then
	# The desktop client starts *your* meeting from its own URL scheme, which needs
	# the meeting number and passcode out of the link.
	confno=$(printf '%s' "$ZOOM_LINK" | sed -n 's|.*/j/\([0-9]\{1,\}\).*|\1|p')
	pwd_param=$(printf '%s' "$ZOOM_LINK" | sed -n 's|.*[?&]pwd=\([^&]*\).*|\1|p')
	if [ -n "$confno" ] && command -v zoom >/dev/null 2>&1; then
		start="zoommtg://zoom.us/start?confno=$confno"
		[ -n "$pwd_param" ] && start="$start&pwd=$pwd_param"
		open_url "$start"
	else
		# No client, or a link in a shape this cannot read: the browser handles both.
		open_url "$ZOOM_LINK"
	fi
	printf '%s — Zoom: %s\n' "$topic" "$ZOOM_LINK"
	exit 0
fi

# ── 2. A Server-to-Server OAuth app: a fresh meeting each time ─────────────────
missing=""
for var in ZOOM_ACCOUNT_ID ZOOM_CLIENT_ID ZOOM_CLIENT_SECRET; do
	eval "value=\${$var:-}"
	[ -z "$value" ] && missing="$missing $var"
done
if [ -n "$missing" ]; then
	# First time only: put the page with the link on it in front of you, since the
	# one thing that cannot be automated is the copy-paste. There is no "log in to
	# Zoom" to run here — every Zoom API route needs an app you register by hand in
	# their web console, so the shortest honest path is their profile page.
	#
	# A marker file, so a second /zoom does not open a second tab.
	marker="${XDG_STATE_HOME:-$HOME/.local/state}/mx-tui/zoom-setup-opened"
	if [ ! -e "$marker" ]; then
		mkdir -p "$(dirname "$marker")" && : >"$marker"
		open_url "https://zoom.us/profile"
		echo "opened zoom.us/profile — copy the invite link under your Personal Meeting ID into $env_file as ZOOM_LINK=\"…\"" >&2
		exit 1
	fi
	# The first line of stderr is what mx-tui shows on the status line, so it says
	# the one thing to do next — and names the cheap option first.
	echo "no Zoom set up yet: paste your personal meeting link as ZOOM_LINK in $env_file (or set$missing there)" >&2
	exit 1
fi

token=$(curl -sS -X POST -u "$ZOOM_CLIENT_ID:$ZOOM_CLIENT_SECRET" \
	"https://zoom.us/oauth/token?grant_type=account_credentials&account_id=$ZOOM_ACCOUNT_ID" |
	jq -r '.access_token // empty')
if [ -z "$token" ]; then
	echo "Zoom refused the credentials in $env_file" >&2
	exit 1
fi

meeting=$(curl -sS -X POST \
	-H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
	-d "$(jq -nc --arg t "$topic" '{topic:$t, type:1, settings:{join_before_host:true}}')" \
	https://api.zoom.us/v2/users/me/meetings)

join=$(printf '%s' "$meeting" | jq -r '.join_url // empty')
start=$(printf '%s' "$meeting" | jq -r '.start_url // empty')
if [ -z "$join" ]; then
	echo "Zoom did not make a meeting: $(printf '%s' "$meeting" | jq -r '.message // "no reason given"')" >&2
	exit 1
fi
[ -n "$start" ] && open_url "$start"

# The link carries the passcode, so this is only for whoever dials in by ID — which
# is exactly what Zoom's own "Copy Invitation" spells out, and the reason a
# per-meeting passcode is worth more than a permanent one.
id=$(printf '%s' "$meeting" | jq -r '.id // empty')
pass=$(printf '%s' "$meeting" | jq -r '.password // empty')
printf '%s — Zoom: %s\n' "$topic" "$join"
[ -n "$id" ] && printf 'Meeting ID: %s%s\n' "$id" "$([ -n "$pass" ] && printf ' · passcode %s' "$pass")"
